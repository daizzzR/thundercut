{
  "manifest_version": 3,
  "name": "ThunderCut",
  "version": "1.2.0",
  "description": "在正在观看的 HTML5 视频区域随机插入本地短片；可随时恢复原视频。无上传、无跳转。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ThunderCut",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "player.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; media-src 'self' blob:; connect-src 'none'"
  }
}
